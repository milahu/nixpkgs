From 34810ea9ce77760663c8ad1d9d218d579f0b23cf Mon Sep 17 00:00:00 2001
From: Milan Hauth <milahu@gmail.com>
Date: Sun, 3 Jul 2022 10:27:20 +0200
Subject: [PATCH] fix node.py debug rollup

---
 src/3rdparty/chromium/third_party/node/node.py | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/3rdparty/chromium/third_party/node/node.py b/src/3rdparty/chromium/third_party/node/node.py
index 4bada5268..7a78b7436 100755
--- a/src/3rdparty/chromium/third_party/node/node.py
+++ b/src/3rdparty/chromium/third_party/node/node.py
@@ -46,6 +46,10 @@ def GetBinaryPath():
 
 
 def RunNode(cmd_parts, stdout=None) -> str or bytes: # FIXME stdout is never used?
+  name = os.path.basename(cmd_parts[0])
+  if name == "rollup":
+    # debug rollup
+    cmd_parts = list(filter(lambda s: s != "--silent", cmd_parts))
   cmd = [GetBinaryPath()] + cmd_parts
   #cmd = ['node'] + cmd_parts # debug
   is_debug = bool(os.environ.get('DEBUG_CHROMIUM_NODE_PY'))
@@ -62,6 +66,7 @@ def RunNode(cmd_parts, stdout=None) -> str or bytes: # FIXME stdout is never use
   if is_debug: # print + capture output https://stackoverflow.com/questions/18421757
     # note: we need live output to debug deadloops
     print(f'node.py[{os.getpid()}]: Running command: {shlex.join(cmd)}')
+    print(f'node.py[{os.getpid()}]: Running command: {shlex.join(cmd)}')
     output = io.BytesIO()
     #line_prefix = b'node.py[%i]:   ' % (os.getpid(),)
     #for line in iter(process.stdout.readline, b''):
