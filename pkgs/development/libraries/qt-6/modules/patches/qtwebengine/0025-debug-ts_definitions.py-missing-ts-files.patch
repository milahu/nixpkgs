From 1b16347be0863aeac42bb74fabdaffb29ae94fee Mon Sep 17 00:00:00 2001
From: Milan Hauth <milahu@gmail.com>
Date: Sun, 3 Jul 2022 11:27:55 +0200
Subject: [PATCH] debug ts_definitions.py missing ts files

---
 .../chromium/tools/typescript/ts_definitions.py      | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/src/3rdparty/chromium/tools/typescript/ts_definitions.py b/src/3rdparty/chromium/tools/typescript/ts_definitions.py
index 9ebba67ff..24e930bb1 100644
--- a/src/3rdparty/chromium/tools/typescript/ts_definitions.py
+++ b/src/3rdparty/chromium/tools/typescript/ts_definitions.py
@@ -79,13 +79,23 @@ def main(argv):
   token = 'TSFILE: '
   generated_files = []
   for l in lines:
-    if token in l:
+    if l.startswith(token):
       generated_files.append(
           os.path.normpath(os.path.relpath(l[len(token):], args.out_dir)))
 
   generated_files.sort()
   args.js_files.sort()
 
+  if len(generated_files) < len(args.js_files):
+    s = 'failed to convert some files from js to ts.\n'
+    s += f'js: {len(args.js_files)} files:\n'
+    for f in args.js_files:
+      s += f'  {f}\n'
+    s += f'ts: {len(generated_files)} files:\n'
+    for f in generated_files:
+      s += f'  {f}\n'
+    raise Exception(s)
+
   unexpected_file = None
   for i, _js_file in enumerate(args.js_files):
     js_file = os.path.normpath(_js_file)
-- 
