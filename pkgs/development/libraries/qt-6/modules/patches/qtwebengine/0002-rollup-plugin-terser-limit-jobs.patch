From bc72bf4ad936b4894356879c3dd4f50a53dd19e7 Mon Sep 17 00:00:00 2001
From: Milan Hauth <milahu@gmail.com>
Date: Sat, 25 Jun 2022 18:48:31 +0200
Subject: [PATCH 2/3] rollup-plugin-terser: limit jobs

---
 .../rollup-plugin-terser/rollup-plugin-terser.js      | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/src/3rdparty/chromium/third_party/devtools-frontend/src/node_modules/rollup-plugin-terser/rollup-plugin-terser.js b/src/3rdparty/chromium/third_party/devtools-frontend/src/node_modules/rollup-plugin-terser/rollup-plugin-terser.js
index 58b76845c..1290cc584 100644
--- a/src/3rdparty/chromium/third_party/devtools-frontend/src/node_modules/rollup-plugin-terser/rollup-plugin-terser.js
+++ b/src/3rdparty/chromium/third_party/devtools-frontend/src/node_modules/rollup-plugin-terser/rollup-plugin-terser.js
@@ -3,6 +3,17 @@ const Worker = require("jest-worker").default;
 const serialize = require("serialize-javascript");
 
 function terser(userOptions = {}) {
+
+// nix: limit job count
+// default: $nproc
+// https://github.com/TrySound/rollup-plugin-terser
+var numWorkers = 0;
+if ('NIX_BUILD_CORES' in process.env) {
+  numWorkers = parseInt(process.env.NIX_BUILD_CORES) - 1;
+  console.log(`rollup-plugin-terser: numWorkers = ${numWorkers}`);
+  userOptions.numWorkers = numWorkers;
+}
+
   if (userOptions.sourceMap != null) {
     throw Error(
       "sourceMap option is removed. Now it is inferred from rollup options."
-- 
