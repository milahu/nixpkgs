From cd735ac9fabac5502ab17f864f951de860b2f917 Mon Sep 17 00:00:00 2001
From: Milan Hauth <milahu@gmail.com>
Date: Tue, 28 Jun 2022 14:33:49 +0200
Subject: [PATCH] debug: src/3rdparty/chromium/third_party/node/node.py

---
 src/3rdparty/chromium/third_party/node/node.py | 14 ++++++++------
 1 file changed, 8 insertions(+), 6 deletions(-)

diff --git a/src/3rdparty/chromium/third_party/node/node.py b/src/3rdparty/chromium/third_party/node/node.py
index aafd41992..d47cdcaab 100755
--- a/src/3rdparty/chromium/third_party/node/node.py
+++ b/src/3rdparty/chromium/third_party/node/node.py
@@ -8,6 +8,7 @@ import platform
 import subprocess
 import sys
 import os
+import shlex
 
 def which(cmd):
     pathenv = os.getenv('PATH')
@@ -46,17 +47,18 @@ def GetBinaryPath():
 def RunNode(cmd_parts, stdout=None):
   cmd = [GetBinaryPath()] + cmd_parts
   process = subprocess.Popen(
-      cmd, cwd=os.getcwd(), stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+      cmd, cwd=os.getcwd(), stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
       universal_newlines=True)
-  stdout, stderr = process.communicate()
+  stdout, _stderr = process.communicate()
 
   if process.returncode != 0:
-    # Handle cases where stderr is empty, even though the command failed, for
-    # example https://github.com/microsoft/TypeScript/issues/615
-    err = stderr if len(stderr) > 0 else stdout
-    raise RuntimeError('Command \'%s\' failed\n%s' % (' '.join(cmd), err))
+    raise RuntimeError('Command failed: %s\n%s' % (shlex.join(cmd), stdout))
+
+  if os.environ.get("DEBUG_CHROMIUM_NODE_PY"):
+    print('Command succeeded: %s\n%s' % (shlex.join(cmd), stdout))
 
   return stdout
 
 if __name__ == '__main__':
+  # note: stdout is not printed
   RunNode(sys.argv[1:])
-- 
