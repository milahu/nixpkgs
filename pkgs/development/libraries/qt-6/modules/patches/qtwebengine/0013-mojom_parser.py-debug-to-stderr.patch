From 200c9e751f3bb0711a694a0d189c2f3dcbb01364 Mon Sep 17 00:00:00 2001
From: Milan Hauth <milahu@gmail.com>
Date: Thu, 30 Jun 2022 16:32:28 +0200
Subject: [PATCH] mojom_parser.py debug to stderr

---
 .../chromium/mojo/public/tools/mojom/mojom_parser.py  | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/src/3rdparty/chromium/mojo/public/tools/mojom/mojom_parser.py b/src/3rdparty/chromium/mojo/public/tools/mojom/mojom_parser.py
index fac5d7caf..06d45ea1f 100755
--- a/src/3rdparty/chromium/mojo/public/tools/mojom/mojom_parser.py
+++ b/src/3rdparty/chromium/mojo/public/tools/mojom/mojom_parser.py
@@ -222,10 +222,15 @@ class _FuncWrapper:
 
 import gnumake_jobclient
 
+def debug(*a, **k):
+  k['file'] = sys.stderr
+  print(*a, **k)
+
 def _grow_pool(pool, new_size, jobclient, worker_tokens):
   delta = new_size - self._pool._processes
   if delta <= 0:
     return
+  debug(f"mojom_parser.py: trying to grow pool by {delta}") # debug
   new_tokens = []
   for i in range(delta):
     token = jobclient.acquire()
@@ -234,18 +239,18 @@ def _grow_pool(pool, new_size, jobclient, worker_tokens):
     new_tokens.append(token)
   if len(new_tokens) == 0:
     return
-  print(f"mojom_parser.py: aquired {len(new_tokens)} tokens") # debug
+  debug(f"mojom_parser.py: aquired {len(new_tokens)} tokens") # debug
   for token in new_tokens:
     worker_tokens.append(token)
   new_size = 1 + len(worker_tokens)
-  print(f"mojom_parser.py: growing pool from {pool._processes} to {new_size}") # debug
+  debug(f"mojom_parser.py: growing pool from {pool._processes} to {new_size}") # debug
   pool._processes = new_size
   pool._repopulate_pool()
 
 def _release_tokens(jobclient, worker_tokens):
   # NOTE this is not optimal (underloading).
   # tokens should be released when workers become idle.
-  print(f"mojom_parser.py: releasing {len(worker_tokens)} tokens") # debug
+  debug(f"mojom_parser.py: releasing {len(worker_tokens)} tokens") # debug
   for token in worker_tokens:
     jobclient.release(token)
 
-- 
2.36.1

