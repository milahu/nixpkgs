From 2d4f9bbd87abcf3645944194a5bc5e72e176a1b7 Mon Sep 17 00:00:00 2001
From: Milan Hauth <milahu@gmail.com>
Date: Sun, 3 Jul 2022 11:44:23 +0200
Subject: [PATCH] fix node.py capture stdout only

---
 .../chromium/third_party/node/node.py         | 20 ++++++++++---------
 1 file changed, 11 insertions(+), 9 deletions(-)

diff --git a/src/3rdparty/chromium/third_party/node/node.py b/src/3rdparty/chromium/third_party/node/node.py
index 7a78b7436..7be25fa65 100755
--- a/src/3rdparty/chromium/third_party/node/node.py
+++ b/src/3rdparty/chromium/third_party/node/node.py
@@ -58,20 +58,22 @@ def RunNode(cmd_parts, stdout=None) -> str or bytes: # FIXME stdout is never use
     #'universal_newlines': True, # -> text=True
     #'text': False, # default
     'close_fds': False, # inherit fds of parent process for gnumake jobclient
-    #'stdout': subprocess.PIPE,
-    #'stderr': subprocess.STDOUT,
+    'stdout': subprocess.PIPE,
+    #'stderr': subprocess.STDOUT, # no. capture stdout only
   }
   process = subprocess.Popen(cmd, **options)
   output = None
   if is_debug: # print + capture output https://stackoverflow.com/questions/18421757
     # note: we need live output to debug deadloops
-    print(f'node.py[{os.getpid()}]: Running command: {shlex.join(cmd)}')
-    print(f'node.py[{os.getpid()}]: Running command: {shlex.join(cmd)}')
     output = io.BytesIO()
-    #line_prefix = b'node.py[%i]:   ' % (os.getpid(),)
-    #for line in iter(process.stdout.readline, b''):
-    #  sys.stdout.buffer.write(line_prefix + line)
-    #  output.write(line)
+    print(f'debug node.py {os.getpid()}: Running command: {shlex.join(cmd)}', file=sys.stderr)
+    line = b'%s\n' % (.encode('utf8'),)
+    sys.stdout.buffer.write(line_prefix + line)
+    #line_prefix = b'debug node.py %i:   ' % (os.getpid(),)
+    for line in iter(process.stdout.readline, b''):
+      #sys.stdout.buffer.write(line_prefix + line)
+      sys.stderr.buffer.write(line) # TODO add newline? b'\n'
+      output.write(line)
     output = output.getvalue()
     process.wait() # set process.returncode
   else: # capture output
@@ -83,7 +85,7 @@ def RunNode(cmd_parts, stdout=None) -> str or bytes: # FIXME stdout is never use
   if process.returncode != 0:
     raise RuntimeError('Command failed with status %i: %s\n%s' % (process.returncode, shlex.join(cmd), output))
   if is_debug:
-    print(f'node.py[{os.getpid()}]: Command succeeded: {shlex.join(cmd)}')
+    print(f'debug node.py {os.getpid()}: Command succeeded: {shlex.join(cmd)}', file=sys.stderr)
   return output
 
 if __name__ == '__main__':
-- 
