From 9d5a8dee9efbcb532716dd868e7e092f1d486138 Mon Sep 17 00:00:00 2001
From: Milan Hauth <milahu@gmail.com>
Date: Sun, 3 Jul 2022 17:12:43 +0200
Subject: [PATCH] node.py fix live output with flush true

---
 src/3rdparty/chromium/third_party/node/node.py | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/src/3rdparty/chromium/third_party/node/node.py b/src/3rdparty/chromium/third_party/node/node.py
index d22346e64..32a7dd5a7 100755
--- a/src/3rdparty/chromium/third_party/node/node.py
+++ b/src/3rdparty/chromium/third_party/node/node.py
@@ -66,12 +66,12 @@ def RunNode(cmd_parts, stdout=None) -> str or bytes: # FIXME stdout is never use
   }
 
   if is_debug:
-    print(f'debug node.py {os.getpid()}: Running command: {shlex.join(cmd)}', file=sys.stderr)
+    print(f'debug node.py {os.getpid()}: Running command: {shlex.join(cmd)}', file=sys.stderr, flush=True)
 
   process = subprocess.Popen(cmd, **options)
 
   if is_debug:
-    print(f'debug node.py {os.getpid()}: Child PID: {process.pid}', file=sys.stderr)
+    print(f'debug node.py {os.getpid()}: Child PID: {process.pid}', file=sys.stderr, flush=True)
 
   output = None
   if is_debug: # print + capture output https://stackoverflow.com/questions/18421757
@@ -80,6 +80,7 @@ def RunNode(cmd_parts, stdout=None) -> str or bytes: # FIXME stdout is never use
     line_prefix = b'debug node.py %i:   ' % (os.getpid(),)
     for line in iter(process.stdout.readline, b''):
       sys.stderr.buffer.write(line_prefix + line)
+      sys.stderr.buffer.flush()
       output.write(line)
     output = output.getvalue()
     process.wait() # set process.returncode
@@ -92,7 +93,7 @@ def RunNode(cmd_parts, stdout=None) -> str or bytes: # FIXME stdout is never use
   if process.returncode != 0:
     raise RuntimeError('Command failed with status %i: %s\n%s' % (process.returncode, shlex.join(cmd), output))
   if is_debug:
-    print(f'debug node.py {os.getpid()}: Command succeeded: {shlex.join(cmd)}', file=sys.stderr)
+    print(f'debug node.py {os.getpid()}: Command succeeded: {shlex.join(cmd)}', file=sys.stderr, flush=True)
   return output
 
 if __name__ == '__main__':
-- 
2.36.1

