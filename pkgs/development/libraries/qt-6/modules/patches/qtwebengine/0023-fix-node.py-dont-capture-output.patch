From 87f527fe5e62e97f88b891eddd14ee458e27c1d7 Mon Sep 17 00:00:00 2001
From: Milan Hauth <milahu@gmail.com>
Date: Sun, 3 Jul 2022 08:46:42 +0200
Subject: [PATCH] fix node.py dont capture output

---
 src/3rdparty/chromium/third_party/node/node.py | 16 +++++++---------
 1 file changed, 7 insertions(+), 9 deletions(-)

diff --git a/src/3rdparty/chromium/third_party/node/node.py b/src/3rdparty/chromium/third_party/node/node.py
index 159ce54c1..4bada5268 100755
--- a/src/3rdparty/chromium/third_party/node/node.py
+++ b/src/3rdparty/chromium/third_party/node/node.py
@@ -54,21 +54,19 @@ def RunNode(cmd_parts, stdout=None) -> str or bytes: # FIXME stdout is never use
     #'universal_newlines': True, # -> text=True
     #'text': False, # default
     'close_fds': False, # inherit fds of parent process for gnumake jobclient
-    'stdout': subprocess.PIPE,
-    'stderr': subprocess.STDOUT,
+    #'stdout': subprocess.PIPE,
+    #'stderr': subprocess.STDOUT,
   }
   process = subprocess.Popen(cmd, **options)
   output = None
   if is_debug: # print + capture output https://stackoverflow.com/questions/18421757
     # note: we need live output to debug deadloops
+    print(f'node.py[{os.getpid()}]: Running command: {shlex.join(cmd)}')
     output = io.BytesIO()
-    line_prefix = b'node.py[%i]: ' % (os.getpid(),)
-    line = b'Running command: %s\n' % (shlex.join(cmd).encode('utf8'),)
-    sys.stdout.buffer.write(line_prefix + line)
-    line_prefix = b'node.py[%i]:   ' % (os.getpid(),)
-    for line in iter(process.stdout.readline, b''):
-      sys.stdout.buffer.write(line_prefix + line)
-      output.write(line)
+    #line_prefix = b'node.py[%i]:   ' % (os.getpid(),)
+    #for line in iter(process.stdout.readline, b''):
+    #  sys.stdout.buffer.write(line_prefix + line)
+    #  output.write(line)
     output = output.getvalue()
     process.wait() # set process.returncode
   else: # capture output
-- 
