From ecd3ddc9560dd306d69565ef989300cb7fb2f448 Mon Sep 17 00:00:00 2001
From: Milan Hauth <milahu@gmail.com>
Date: Thu, 30 Jun 2022 22:46:17 +0200
Subject: [PATCH] gn: debug token release

---
 src/3rdparty/gn/src/util/worker_pool.cc | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/src/3rdparty/gn/src/util/worker_pool.cc b/src/3rdparty/gn/src/util/worker_pool.cc
index 8f228c017..2e344d1a2 100644
--- a/src/3rdparty/gn/src/util/worker_pool.cc
+++ b/src/3rdparty/gn/src/util/worker_pool.cc
@@ -119,6 +119,7 @@ WorkerPool::WorkerPool(size_t thread_count) : should_stop_processing_(false) {
   }
 
   // TODO later: try to grow pool = add more threads
+  // TODO later: release all tokens
 
   threads_.reserve(thread_count);
   for (size_t i = 0; i < thread_count; ++i) {
@@ -135,19 +136,32 @@ WorkerPool::WorkerPool(size_t thread_count) : should_stop_processing_(false) {
 }
 
 WorkerPool::~WorkerPool() {
+  printf("gn: jobclient: WorkerPool::~WorkerPool\n");
   {
     std::unique_lock<std::mutex> queue_lock(queue_mutex_);
     should_stop_processing_ = true;
   }
 
+  printf("gn: jobclient: pool_notifier_.notify_all\n");
   pool_notifier_.notify_all();
 
+  printf("gn: jobclient: task_thread.join ...\n");
+  int token;
   for (auto& task_thread : threads_) {
     task_thread.join();
+    // release tokens one by one
+    if (tokens_.size() > 0) {
+      printf("gn: jobclient: releasing token\n");
+      token = tokens_.back();
+      tokenpool_->ReleaseToken(token);
+      tokens_.pop_back();
+    }
   }
 
+  /* FIXME this is never reached?
   if (tokenpool_ != NULL) {
     // release tokens back to jobserver
+    // FIXME this is never reached?
     printf("gn: jobclient: releasing %li tokens\n", tokens_.size());
     int token;
     while (tokens_.size() > 0) {
@@ -161,6 +175,7 @@ WorkerPool::~WorkerPool() {
     delete tokenpool_;
     tokenpool_ = NULL;
   }
+  */
 }
 
 void WorkerPool::PostTask(std::function<void()> work) {
-- 
2.36.1

