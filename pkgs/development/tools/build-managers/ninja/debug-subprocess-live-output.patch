+void Subprocess::OnPipeReadyBuf(char* buf, size_t buf_size, ssize_t* len) {
+  *len = read(fd_, buf, buf_size);
+  if (*len > 0) {
+    buf_.append(buf, *len);
+  } else {
+    if (*len < 0)
+      Fatal("read: %s", strerror(errno));
+    close(fd_);
+    fd_ = -1;
+  }
+}
