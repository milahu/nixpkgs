+void SubprocessOutput(const char* line_prefix, const char* buf, size_t len) {
+  if (len == 0) return;
+  puts(line_prefix);
+  for (size_t i = 0; i < len; i++) {
+    putchar(buf[i]);
+    if (buf[i] == '\n') {
+      puts(line_prefix);
+    }
+  }
+  if (buf[(len - 1)] != '\n') putchar('\n');
+}
