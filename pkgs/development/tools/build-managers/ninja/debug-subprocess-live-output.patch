+void SubprocessOutput(char* line_prefix, char* buf, size_t len) {
+  if (len == 0) return;
+  printf("SubprocessOutput: len = %i\n", len);
+  puts(line_prefix);
+  for (size_t i = 0; i < len; i++) {
+    putchar(buf[i]);
+    if (buf[i] == '\n') {
+      puts(line_prefix);
+    }
+  }
+  if (buf[(len - 1)] != '\n') putchar('\n');
+}
