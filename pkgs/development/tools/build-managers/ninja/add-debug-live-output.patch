+  char line_prefix[100];
+  assert(snprintf(line_prefix, 100, "pid %d: ", pid_) < 100);
+  //liveoutput_ = new oprefixstream(line_prefix, std::cout); // no output
+  liveoutput_ = new oprefixstream(line_prefix, std::cerr);
+
   close(output_pipe[1]);
   return true;
 }
@@ -139,6 +144,8 @@ void Subprocess::OnPipeReady() {
   ssize_t len = read(fd_, buf, sizeof(buf));
   if (len > 0) {
     buf_.append(buf, len);
+    liveoutput_->write(buf, len);
+    //liveoutput_->flush();
   } else {
     if (len < 0)
       Fatal("read: %s", strerror(errno));
