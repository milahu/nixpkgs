From d0b090a05fe2a53c10a02271e5667c7fb8075036 Mon Sep 17 00:00:00 2001
From: milahu <milahu@gmail.com>
Date: Tue, 14 Feb 2023 17:51:54 +0100
Subject: [PATCH] modulate payload instead of agent and gadget

---
 lib/agent/meson.build   | 29 ++----------------
 lib/gadget/meson.build  | 38 ++---------------------
 lib/payload/meson.build | 67 +++++++++++++++++++++++++++++++++++++++++
 3 files changed, 71 insertions(+), 63 deletions(-)

diff --git a/lib/agent/meson.build b/lib/agent/meson.build
index f894734..bd63fd6 100644
--- a/lib/agent/meson.build
+++ b/lib/agent/meson.build
@@ -29,39 +29,14 @@ if host_os_family in ['linux', 'qnx']
   extra_link_args += ['-Wl,-Bsymbolic']
 endif
 
-raw_agent = shared_library('frida-agent', agent_sources,
+modulated_agent = shared_library('frida-agent', agent_sources,
   name_prefix: 'lib',
   c_args: frida_component_cflags,
   vala_args: extra_vala_args,
   link_args: extra_link_args,
   vs_module_defs: 'frida-agent.def',
   override_options: ['b_asneeded=true'],
-  dependencies: [gio_dep, gee_dep, gum_dep, gumjs_dep, base_dep, pipe_dep, tls_provider_dep, payload_dep],
-)
-
-operations = ['--move', 'constructor', 'frida_init_memory', 'first']
-if host_os_family != 'darwin'
-  operations += ['--move', 'destructor', 'frida_deinit_memory', 'first']
-endif
-
-if host_machine.endian() == 'little'
-  endian_option = ['--endian', 'little']
-else
-  endian_option = ['--endian', 'big']
-endif
-
-modulated_agent = custom_target('frida-agent-modulated',
-  input: raw_agent,
-  output: 'libfrida-agent-modulated' + shlib_suffix,
-  command: [
-    modulate,
-    '@INPUT@',
-    ] + operations + endian_option + [
-    '--output', '@OUTPUT@',
-    '--nm', nm,
-    '--readelf', readelf,
-    '--otool', otool,
-  ],
+  dependencies: [gio_dep, gee_dep, gum_dep, gumjs_dep, base_dep, pipe_dep, tls_provider_dep, agent_payload_modulated_dep],
 )
 
 if host_os_family == 'darwin'
diff --git a/lib/gadget/meson.build b/lib/gadget/meson.build
index 977dab5..31b1830 100644
--- a/lib/gadget/meson.build
+++ b/lib/gadget/meson.build
@@ -42,7 +42,7 @@ if host_os_family in ['linux', 'qnx']
   extra_link_args += ['-Wl,-Bsymbolic']
 endif
 
-raw_gadget = shared_library('frida-gadget', gadget_sources,
+modulated_gadget = shared_library('frida-gadget', gadget_sources,
   name_prefix: 'lib',
   c_args: frida_component_cflags,
   objc_args: extra_objc_args,
@@ -50,41 +50,7 @@ raw_gadget = shared_library('frida-gadget', gadget_sources,
   link_depends: extra_link_depends,
   vs_module_defs: 'frida-gadget.def',
   override_options: ['b_asneeded=true'],
-  dependencies: [gio_dep, gee_dep, json_glib_dep, gum_dep, gumjs_dep, base_dep, tls_provider_dep, payload_dep] + platform_deps,
-)
-
-operations = [
-  '--move', 'constructor', 'frida_init_memory', 'first',
-  '--move', 'constructor', 'frida_on_load', 'last',
-]
-if host_os_family != 'darwin'
-  operations += [
-    '--move', 'destructor', 'frida_deinit_memory', 'first',
-    '--move', 'destructor', 'frida_on_unload', 'last',
-  ]
-endif
-if get_option('strip')
-  operations += ['--strip', '>>>', strip, '<<<']
-endif
-
-if host_machine.endian() == 'little'
-  endian_option = ['--endian', 'little']
-else
-  endian_option = ['--endian', 'big']
-endif
-
-modulated_gadget = custom_target('frida-gadget-modulated',
-  input: raw_gadget,
-  output: 'libfrida-gadget-modulated' + shlib_suffix,
-  command: [
-    modulate,
-    '@INPUT@',
-    ] + operations + endian_option + [
-    '--output', '@OUTPUT@',
-    '--nm', nm,
-    '--readelf', readelf,
-    '--otool', otool,
-  ],
+  dependencies: [gio_dep, gee_dep, json_glib_dep, gum_dep, gumjs_dep, base_dep, tls_provider_dep, gadget_payload_modulated_dep] + platform_deps,
 )
 
 if host_os == 'macos'
diff --git a/lib/payload/meson.build b/lib/payload/meson.build
index 8065a69..ca8d867 100644
--- a/lib/payload/meson.build
+++ b/lib/payload/meson.build
@@ -45,11 +45,78 @@ payload = library('frida-payload-' + api_version, payload_sources,
   install: true,
 )
 
+if host_machine.endian() == 'little'
+  endian_option = ['--endian', 'little']
+else
+  endian_option = ['--endian', 'big']
+endif
+
+# modulate for frida-agent
+
+operations = ['--move', 'constructor', 'frida_init_memory', 'first']
+if host_os_family != 'darwin'
+  operations += ['--move', 'destructor', 'frida_deinit_memory', 'first']
+endif
+
+agent_payload_modulated = custom_target('frida-agent-payload-modulated-' + api_version,
+  input: payload, # aka: raw_payload
+  output: 'libfrida-agent-payload-modulated' + shlib_suffix,
+  command: [
+    modulate,
+    '@INPUT@',
+    ] + operations + endian_option + [
+    '--output', '@OUTPUT@',
+    '--nm', nm,
+    '--readelf', readelf,
+    '--otool', otool,
+  ],
+)
+
+# modulate for frida-gadget
+
+operations = [
+  '--move', 'constructor', 'frida_init_memory', 'first',
+  '--move', 'constructor', 'frida_on_load', 'last',
+]
+if host_os_family != 'darwin'
+  operations += [
+    '--move', 'destructor', 'frida_deinit_memory', 'first',
+    '--move', 'destructor', 'frida_on_unload', 'last',
+  ]
+endif
+if get_option('strip')
+  operations += ['--strip', '>>>', strip, '<<<']
+endif
+
+gadget_payload_modulated = custom_target('frida-gadget-payload-modulated',
+  input: raw_gadget,
+  output: 'libfrida-gadget-payload-modulated' + shlib_suffix,
+  command: [
+    modulate,
+    '@INPUT@',
+    ] + operations + endian_option + [
+    '--output', '@OUTPUT@',
+    '--nm', nm,
+    '--readelf', readelf,
+    '--otool', otool,
+  ],
+)
+
 payload_dep = declare_dependency(
   include_directories: include_directories('.'),
   link_with: payload,
 )
 
+agent_payload_modulated_dep = declare_dependency(
+  include_directories: include_directories('.'),
+  link_with: agent_payload_modulated,
+)
+
+gadget_payload_modulated_dep = declare_dependency(
+  include_directories: include_directories('.'),
+  link_with: gadget_payload_modulated,
+)
+
 pkg = import('pkgconfig')
 pkg.generate(payload,
   description: 'Frida payload library intended for static linking into payloads',
-- 
2.39.0

