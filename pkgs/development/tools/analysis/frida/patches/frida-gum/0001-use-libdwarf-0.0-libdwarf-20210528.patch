From: Milan Hauth <milahu@gmail.com>
Date: Wed, 1 Feb 2023 09:49:02 +0100
Subject: [PATCH 1/5] use libdwarf 0.0 = libdwarf 20210528

---
 meson.build | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/meson.build b/meson.build
index 43ba4ff..79e89e6 100644
--- a/meson.build
+++ b/meson.build
@@ -470,7 +470,7 @@ if host_os_family in ['linux', 'freebsd', 'qnx']
     endif
   endif
 
-  libdwarf_dep = dependency('libdwarf', required: false)
+  libdwarf_dep = dependency('libdwarf', required: false, version: '< 0.1')
   if not libdwarf_dep.found()
     found = false
     if not meson.is_cross_build()
