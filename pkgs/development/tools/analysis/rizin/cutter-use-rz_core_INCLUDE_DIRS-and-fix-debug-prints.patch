From 8161183046f789b6f4aa5bcf33da0dfc0d9a3789 Mon Sep 17 00:00:00 2001
From: milahu <milahu@gmail.com>
Date: Thu, 16 Feb 2023 20:32:16 +0100
Subject: [PATCH] use rz_core_INCLUDE_DIRS and fix debug prints

---
 CMakeLists.txt     | 12 +++++++++---
 src/CMakeLists.txt | 30 ++++++++++++++++++++++--------
 2 files changed, 31 insertions(+), 11 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index ab18bbe..4bba254 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -77,9 +77,15 @@ else()
     find_package(Rizin COMPONENTS Core REQUIRED)
 
     # FIXME empty -> /build/source/src/core/CutterCommon.h:8:10: fatal: 'rz_core.h' file not found
-    message("debug: CMakeLists.txt: Rizin_INCLUDE_DIRS = ${Rizin_INCLUDE_DIRS}")
-    message("debug: CMakeLists.txt: RAW_RIZIN_INCLUDE_DIRS = ${RAW_RIZIN_INCLUDE_DIRS}")
-    message("debug: CMakeLists.txt: rz_core_INCLUDE_DIRS = ${rz_core_INCLUDE_DIRS}")
+    message("debug: CMakeLists.txt:80: Rizin_INCLUDE_DIRS = ${Rizin_INCLUDE_DIRS}")
+    message("debug: CMakeLists.txt:80: RAW_RIZIN_INCLUDE_DIRS = ${RAW_RIZIN_INCLUDE_DIRS}")
+    message("debug: CMakeLists.txt:80: rz_core_INCLUDE_DIRS = ${rz_core_INCLUDE_DIRS}")
+
+    #[[
+    debug: CMakeLists.txt: Rizin_INCLUDE_DIRS = 
+    debug: CMakeLists.txt: RAW_RIZIN_INCLUDE_DIRS = 
+    debug: CMakeLists.txt: rz_core_INCLUDE_DIRS = /nix/store/wmdk06q14wgfznms23ypmazimw9g4idj-rizin-0.4.1-unstable-2023-02-16/include/librz;/nix/store/wmdk06q14wgfznms23ypmazimw9g4idj-rizin-0.4.1-unstable-2023-02-16/include/librz/sdb
+    ]]#
 
     set(RIZIN_TARGET Rizin::Core)
 endif()
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 84faedb..3a6fa3a 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -436,11 +436,18 @@ if(CUTTER_ENABLE_PYTHON_BINDINGS)
     endforeach()
 
     # FIXME empty -> /build/source/src/core/CutterCommon.h:8:10: fatal: 'rz_core.h' file not found
-    message("debug: src/CMakeLists.txt: Rizin_INCLUDE_DIRS = ${Rizin_INCLUDE_DIRS}")
-    message("debug: src/CMakeLists.txt: RAW_RIZIN_INCLUDE_DIRS = ${RAW_RIZIN_INCLUDE_DIRS}")
-    message("debug: src/CMakeLists.txt: rz_core_INCLUDE_DIRS = ${rz_core_INCLUDE_DIRS}")
-
-    list(APPEND SHIBOKEN_INCLUDE_DIRS ${RAW_RIZIN_INCLUDE_DIRS})
+    message("debug: src/CMakeLists.txt:440: Rizin_INCLUDE_DIRS = ${Rizin_INCLUDE_DIRS}")
+    message("debug: src/CMakeLists.txt:440: RAW_RIZIN_INCLUDE_DIRS = ${RAW_RIZIN_INCLUDE_DIRS}")
+    message("debug: src/CMakeLists.txt:440: rz_core_INCLUDE_DIRS = ${rz_core_INCLUDE_DIRS}")
+
+    #[[
+    debug: src/CMakeLists.txt: Rizin_INCLUDE_DIRS = 
+    debug: src/CMakeLists.txt: RAW_RIZIN_INCLUDE_DIRS = 
+    debug: src/CMakeLists.txt: rz_core_INCLUDE_DIRS = /nix/store/wmdk06q14wgfznms23ypmazimw9g4idj-rizin-0.4.1-unstable-2023-02-16/include/librz;/nix/store/wmdk06q14wgfznms23ypmazimw9g4idj-rizin-0.4.1-unstable-2023-02-16/include/librz/sdb
+    debug: RAW_RIZIN_INCLUDE_DIRS = /nix/store/wmdk06q14wgfznms23ypmazimw9g4idj-rizin-0.4.1-unstable-2023-02-16/include/librz;/nix/store/wmdk06q14wgfznms23ypmazimw9g4idj-rizin-0.4.1-unstable-2023-02-16/include/librz/sdb
+    ]]#
+
+    list(APPEND SHIBOKEN_INCLUDE_DIRS ${rz_core_INCLUDE_DIRS})
     if (NOT WIN32)
         string(REPLACE ";" ":" SHIBOKEN_INCLUDE_DIRS "${SHIBOKEN_INCLUDE_DIRS}")
     endif()
@@ -538,9 +545,11 @@ if(CUTTER_ENABLE_PYTHON)
         get_target_property(RAW_BINDINGS_INCLUDE_DIRS Cutter INCLUDE_DIRECTORIES)
         if(NOT CUTTER_USE_BUNDLED_RIZIN)
             get_target_property(RAW_RIZIN_INCLUDE_DIRS ${RIZIN_TARGET} INTERFACE_INCLUDE_DIRECTORIES)
-            list(APPEND RAW_BINDINGS_INCLUDE_DIRS "${RAW_RIZIN_INCLUDE_DIRS}")
+            list(APPEND RAW_BINDINGS_INCLUDE_DIRS "${rz_core_INCLUDE_DIRS}")
 
-        message("debug: RAW_RIZIN_INCLUDE_DIRS = ${RAW_RIZIN_INCLUDE_DIRS}")
+            message("debug: src/CMakeLists.txt:550: Rizin_INCLUDE_DIRS = ${Rizin_INCLUDE_DIRS}")
+            message("debug: src/CMakeLists.txt:550: RAW_RIZIN_INCLUDE_DIRS = ${RAW_RIZIN_INCLUDE_DIRS}")
+            message("debug: src/CMakeLists.txt:550: rz_core_INCLUDE_DIRS = ${rz_core_INCLUDE_DIRS}")
 
         endif()
         set(BINDINGS_INCLUDE_DIRS "")
@@ -563,7 +572,12 @@ if(CUTTER_ENABLE_PYTHON)
         else()
             list(APPEND BINDINGS_INCLUDE_DIRS ${Qt5Core_INCLUDE_DIRS} ${Qt5Widgets_INCLUDE_DIRS} ${Qt5Gui_INCLUDE_DIRS})
         endif()
-        list(APPEND BINDINGS_INCLUDE_DIRS ${RAW_RIZIN_INCLUDE_DIRS})
+
+        message("debug: src/CMakeLists.txt:570: Rizin_INCLUDE_DIRS = ${Rizin_INCLUDE_DIRS}")
+        message("debug: src/CMakeLists.txt:570: RAW_RIZIN_INCLUDE_DIRS = ${RAW_RIZIN_INCLUDE_DIRS}")
+        message("debug: src/CMakeLists.txt:570: rz_core_INCLUDE_DIRS = ${rz_core_INCLUDE_DIRS}")
+
+        list(APPEND BINDINGS_INCLUDE_DIRS ${rz_core_INCLUDE_DIRS})
         list(APPEND BINDINGS_INCLUDE_DIRS "${CMAKE_CURRENT_SOURCE_DIR}")
         if (NOT WIN32)
             string(REPLACE ";" ":" BINDINGS_INCLUDE_DIRS "${BINDINGS_INCLUDE_DIRS}")
-- 
