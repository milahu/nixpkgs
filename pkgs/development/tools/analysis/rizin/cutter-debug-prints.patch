From 1351369ec81b881229bee48e82be940e3f1f8ba5 Mon Sep 17 00:00:00 2001
From: milahu <milahu@gmail.com>
Date: Thu, 16 Feb 2023 20:04:53 +0100
Subject: [PATCH] debug prints

---
 CMakeLists.txt     | 5 +++++
 src/CMakeLists.txt | 7 +++++++
 2 files changed, 12 insertions(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index d64999d..08f5920 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -75,6 +75,11 @@ if(CUTTER_USE_BUNDLED_RIZIN)
     set(RIZIN_TARGET Rizin)
 else()
     find_package(Rizin COMPONENTS Core REQUIRED)
+
+    # FIXME empty -> /build/source/src/core/CutterCommon.h:8:10: fatal: 'rz_core.h' file not found
+    message("debug: Rizin_INCLUDE_DIRS = ${Rizin_INCLUDE_DIRS}")
+    message("debug: rz_core_INCLUDE_DIRS = ${rz_core_INCLUDE_DIRS}")
+
     set(RIZIN_TARGET Rizin::Core)
 endif()
 
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 96e01ce..53cd202 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -434,6 +434,10 @@ if(CUTTER_ENABLE_PYTHON_BINDINGS)
             $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/cutter/${_dir}>
         )
     endforeach()
+
+    # FIXME empty -> /build/source/src/core/CutterCommon.h:8:10: fatal: 'rz_core.h' file not found
+    message("debug: Rizin_INCLUDE_DIRS = ${Rizin_INCLUDE_DIRS}")
+
     list(APPEND SHIBOKEN_INCLUDE_DIRS ${Rizin_INCLUDE_DIRS})
     if (NOT WIN32)
         string(REPLACE ";" ":" SHIBOKEN_INCLUDE_DIRS "${SHIBOKEN_INCLUDE_DIRS}")
@@ -533,6 +537,9 @@ if(CUTTER_ENABLE_PYTHON)
         if(NOT CUTTER_USE_BUNDLED_RIZIN)
             get_target_property(RAW_RIZIN_INCLUDE_DIRS ${RIZIN_TARGET} INTERFACE_INCLUDE_DIRECTORIES)
             list(APPEND RAW_BINDINGS_INCLUDE_DIRS "${RAW_RIZIN_INCLUDE_DIRS}")
+
+        message("debug: RAW_RIZIN_INCLUDE_DIRS = ${RAW_RIZIN_INCLUDE_DIRS}")
+
         endif()
         set(BINDINGS_INCLUDE_DIRS "")
         foreach(_dir ${RAW_BINDINGS_INCLUDE_DIRS})
-- 
2.39.0

